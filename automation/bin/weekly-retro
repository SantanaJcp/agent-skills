#!/usr/bin/env bash
# Weekly retro: one unattended Claude Code run of the retro skill over the last week of transcripts.
# It only writes a report with proposals; nothing is applied.
# Usage: weekly-retro
set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
STATE_ROOT="${KITCHEN_STATE:-$HOME/.local/state/kitchen}"
RETRO_DIR="$STATE_ROOT/retro"
mkdir -p "$RETRO_DIR/logs"
export PATH="${EXTRA_PATH:-}:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_LOG="$RETRO_DIR/logs/retro-$RUN_ID.log"
exec > >(tee -a "$RUN_LOG") 2>&1
log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

log "retro start"
cd "$REPO"
status=0
claude -p "/retro Unattended weekly run: nobody answers questions. Write the report file and stop." \
  --permission-mode acceptEdits \
  --allowedTools "Bash(kitchen retro:*)" "Read" "Grep" "Glob" "Write" \
  --add-dir "$RETRO_DIR" \
  --output-format text || status=$?
find "$RETRO_DIR/logs" -name 'retro-*' -mtime +90 -delete
log "retro end: status=$status"
exit "$status"
