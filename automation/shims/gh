#!/usr/bin/env bash
# gh for unattended jobs: everything passes through except merging PRs and deleting repos.
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "merge" ]; then
  echo "kitchen automation: 'gh pr merge' is blocked for automation" >&2; exit 1
fi
if [ "${1:-}" = "repo" ] && [ "${2:-}" = "delete" ]; then
  echo "kitchen automation: 'gh repo delete' is blocked for automation" >&2; exit 1
fi
if [ -z "${KITCHEN_REAL_GH:-}" ] || [ ! -x "$KITCHEN_REAL_GH" ]; then
  echo "kitchen automation: gh is not installed (KITCHEN_REAL_GH is empty)" >&2; exit 127
fi
exec "$KITCHEN_REAL_GH" "$@"
