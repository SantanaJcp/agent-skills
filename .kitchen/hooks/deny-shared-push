#!/usr/bin/env python3
"""PreToolUse guard: deny `git push` whose destination is dev, main, master or a configured shared branch.

Extra shared branches (names or shell globs, one per line) live in ~/.config/kitchen/shared-branches.txt.
Principles: `doors` (a shared branch changes only on the owner's explicit request)."""
import fnmatch
import os
import sys

sys.dont_write_bytecode = True

GUARD = "deny-shared-push"
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import shellparse  # noqa: E402
except Exception as error:  # noqa: BLE001 - a guard that cannot load must block, not exit 1
    sys.stderr.write(f"Blocked by the kitchen hook {GUARD}: cannot load hooks/shellparse.py ({error}). Run `kitchen doctor`.\n")
    sys.exit(2)
DEFAULT_SHARED = ("dev", "main", "master")
PUSH_SHORT_WITH_VALUE = set("o")
PUSH_LONG_WITH_VALUE = ("--repo", "--push-option", "--receive-pack", "--exec")
ALL_BRANCHES = ("--all", "--branches", "--mirror")
# Config that decides where a push goes. A -c or GIT_CONFIG_* that sets one is not resolved: it blocks.
PUSH_CONFIG_PREFIXES = ("push.", "remote.", "branch.", "include.", "includeif.")
ADVICE = ("Push your own branch instead (`git push -u origin <your-branch>`) and open a pull request. "
          "Shared branches change only on the owner's explicit request, and then the owner runs the push.")
BY_HAND = ("If this push is meant and safe, write the remote and branch literally (`git push origin <your-branch>`), "
           "or ask the owner to run it by hand.")


def shared_patterns():
    config = os.environ.get("KITCHEN_CONFIG") or os.path.join(os.path.expanduser("~"), ".config", "kitchen")
    patterns = list(DEFAULT_SHARED)
    try:
        with open(os.path.join(config, "shared-branches.txt"), encoding="utf-8") as handle:
            patterns += [line.strip() for line in handle if line.strip() and not line.startswith("#")]
    except FileNotFoundError:
        pass
    return patterns


def shared(branch, patterns):
    if branch.startswith("refs/"):
        if not branch.startswith("refs/heads/"):
            return False  # tags, notes
        branch = branch[len("refs/heads/"):]
    return any(fnmatch.fnmatchcase(branch, p) or fnmatch.fnmatchcase(p, branch) for p in patterns)


def abbreviates(option, full):
    """git accepts any unambiguous prefix of a long option: --mir is --mirror."""
    return len(option) > 2 and full.startswith(option)


def current_branch(call):
    branch = shellparse.run_git(call, "symbolic-ref", "--quiet", "--short", "HEAD")
    if not branch:
        return None, None
    upstream = shellparse.run_git(call, "config", "--get", f"branch.{branch}.merge")
    return branch, upstream


def parse_push(args):
    """(long options seen, short options seen, positionals) of a push command line."""
    longs, shorts, positionals, i = [], set(), [], 0
    while i < len(args):
        arg = args[i]
        if arg.dynamic:
            positionals.append(arg)
        elif arg.value == "--":
            positionals += args[i + 1:]
            break
        elif arg.value.startswith("--"):
            name = arg.value.split("=", 1)[0]
            longs.append(name)
            if "=" not in arg.value and any(abbreviates(name, full) for full in PUSH_LONG_WITH_VALUE):
                i += 1
        elif arg.value.startswith("-") and len(arg.value) > 1:
            for position, letter in enumerate(arg.value[1:]):
                shorts.add(letter)
                if letter in PUSH_SHORT_WITH_VALUE:
                    if position == len(arg.value) - 2:
                        i += 1
                    break
        else:
            positionals.append(arg)
        i += 1
    return longs, shorts, positionals


def unresolvable(call):
    """Why the destination of this push cannot be known statically, or None."""
    if call.sub is None:
        return "the git subcommand is a variable or a command output, so this may be a push the hook cannot check."
    if call.cmd.more_args:
        return "xargs or find -exec adds arguments to this git command that the hook cannot see."
    keys = [key for key, _ in call.config if key == "<unknown>" or key.startswith(PUSH_CONFIG_PREFIXES)]
    if keys:
        return f"`{keys[0]}` is set for this command, and it decides where the push goes."
    files = shellparse.config_files(call)
    if files:
        return f"{files[0]} points git at a config file the hook has not read."
    return None


def destinations(call, patterns):
    """Reasons this push would, or might, update a shared branch."""
    longs, shorts, positionals = parse_push(call.args)
    every = sorted({full for name in longs for full in ALL_BRANCHES if abbreviates(name, full)})
    if every:
        return [f"`git push {' '.join(longs)}` means {' or '.join(every)}, which pushes every local branch, shared ones included."]
    if positionals and positionals[0].dynamic:
        return ["cannot tell where this push goes: the remote is a variable or a command output. " + BY_HAND]
    refspecs = positionals[1:]
    reasons = []
    deleting = "d" in shorts or any(abbreviates(name, "--delete") for name in longs)
    if not refspecs:
        default = shellparse.run_git(call, "config", "--get", "push.default")
        branch, upstream = current_branch(call)
        if default == "matching":
            return ["push.default is `matching`, so a bare `git push` updates every branch the remote also has, shared ones included."]
        if branch is None:
            return ["cannot tell which branch a `git push` without a refspec updates (no repo, detached HEAD or unknown directory). "
                    "Name it: `git push origin <your-branch>`."]
        for name in (branch, upstream):
            if name and shared(name, patterns):
                reasons.append(f"`git push` from branch `{branch}` updates the shared branch `{name.replace('refs/heads/', '', 1)}`.")
        return reasons[:1]
    skip_tag = False
    for spec in refspecs:
        if skip_tag:
            skip_tag = False
            continue
        if spec.dynamic:
            return [f"cannot tell where `{spec.value}` pushes: it is a variable or a command output. " + BY_HAND]
        value = spec.value.lstrip("+")
        if value == "tag":
            skip_tag = True
            continue
        if deleting:
            src, dst = None, value
        elif ":" in value:
            src, dst = value.split(":", 1)
        else:
            src, dst = value, value
        if not dst:
            what = "the matching refspec `:`, which pushes every branch the remote also has" if not src else \
                f"`{spec.value}` has no destination, so git picks one from config"
            return [f"{what}; shared branches can be among them. {BY_HAND}"]
        if dst in ("HEAD", "@") or (src in ("HEAD", "@") and dst == src):
            branch, _ = current_branch(call)
            if branch is None:
                return [f"cannot tell which branch `{value}` names (no repo, detached HEAD or unknown directory). "
                        "Name the destination: `git push origin HEAD:<your-branch>`."]
            dst = branch
        if shared(dst, patterns):
            reasons.append(f"`git push` to `{dst.replace('refs/heads/', '', 1)}`, a shared branch.")
    return reasons


def check(commands):
    patterns = shared_patterns()
    reasons = []
    for cmd in commands:
        call = shellparse.git_call(cmd)
        if call is None or call.sub not in ("push", None, ""):
            continue
        if call.sub == "" and not cmd.more_args:
            continue  # bare `git`, `git --version`
        why = unresolvable(call)
        if why:
            reasons.append(f"{why} {BY_HAND} {ADVICE}")
            continue
        reasons += [f"{reason} {ADVICE}" for reason in destinations(call, patterns)]
    return reasons


if __name__ == "__main__":
    shellparse.main(GUARD, check)
