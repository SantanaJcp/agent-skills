#!/usr/bin/env python3
"""PreToolUse guard: deny git commands that skip the repo's hooks (--no-verify, commit -n, a core.hooksPath override)."""
import os
import sys

sys.dont_write_bytecode = True

GUARD = "deny-no-verify"
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import shellparse  # noqa: E402
except Exception as error:  # noqa: BLE001 - a guard that cannot load must block, not exit 1
    sys.stderr.write(f"Blocked by the kitchen hook {GUARD}: cannot load hooks/shellparse.py ({error}). Run `kitchen doctor`.\n")
    sys.exit(2)
HOOKED = {"commit", "merge", "push", "am", "rebase", "cherry-pick", "revert"}
# Short options of `git commit` that take a value: in `-mn` the n is the message, in `-nm msg` it is --no-verify.
COMMIT_SHORT_WITH_VALUE = set("mFcCt")
COMMIT_SHORT_OPTIONAL_ATTACHED = set("Su")
COMMIT_LONG_WITH_VALUE = {"--message", "--file", "--reuse-message", "--reedit-message", "--fixup", "--squash", "--author",
                          "--date", "--template", "--cleanup", "--trailer", "--pathspec-from-file"}
ADVICE = ("Run it without that option. If a hook fails, fix what it reports (in the kitchen, `bin/kitchen check` shows "
          "the same failures); if the hook itself is broken, stop and tell the owner instead of skipping it.")


HOOKS_CONFIG = ("core.hookspath", "include.", "includeif.", "<unknown>")


def is_no_verify(value):
    # git accepts unambiguous prefixes of long options: --no-veri is --no-verify (--no-ve could be --no-verbose).
    return len(value) >= len("--no-veri") and "--no-verify".startswith(value)


def short_cluster(letters):
    """'n' when the cluster turns on -n, 'value' when a letter takes the rest as its value, else None."""
    for letter in letters:
        if letter == "n":
            return "n"
        if letter in COMMIT_SHORT_WITH_VALUE or letter in COMMIT_SHORT_OPTIONAL_ATTACHED:
            return "value"
    return None


def commit_problem(args):
    """Why this `git commit` skips hooks, or might: None when it does not."""
    i = 0
    while i < len(args):
        arg, value = args[i], args[i].value
        if arg.dynamic:
            # Only the literal start of the word is known: `--message=$(...)` and `-m"$X"` are values, `$X` could be -n.
            known = value.split("$", 1)[0]
            if known.startswith("--") and "=" in known and known.split("=", 1)[0] in COMMIT_LONG_WITH_VALUE:
                pass
            elif known.startswith("-") and len(known) > 1 and not known.startswith("--") and short_cluster(known[1:]) == "value":
                pass
            elif known and not known.startswith("-"):
                pass  # a path
            else:
                return f"`{value}` is a variable or a command output in option position: it could be -n or --no-verify."
        elif value == "--":
            return None
        elif value.startswith("--"):
            if is_no_verify(value):
                return "no-verify"
            if value in COMMIT_LONG_WITH_VALUE:
                i += 1
        elif value.startswith("-") and len(value) > 1:
            found = short_cluster(value[1:])
            if found == "n":
                return "no-verify"
            letters = value[1:]
            taker = next((k for k, ch in enumerate(letters) if ch in COMMIT_SHORT_WITH_VALUE or ch in COMMIT_SHORT_OPTIONAL_ATTACHED), None)
            if taker is not None and letters[taker] in COMMIT_SHORT_WITH_VALUE and taker == len(letters) - 1:
                i += 1
        i += 1
    return None


def check(commands):
    reasons = []
    for cmd in commands:
        call = shellparse.git_call(cmd)
        if call is None:
            continue
        if call.sub is None:
            reasons.append("the git subcommand is a variable or a command output, so this may be a commit the hook cannot check. "
                           "Write the git command literally. " + ADVICE)
            continue
        if call.sub not in HOOKED and not (call.sub == "" and cmd.more_args):
            continue
        name = call.sub or "<subcommand from input>"
        if cmd.more_args:
            reasons.append(f"xargs or find -exec adds arguments to `git {name}` that the hook cannot see; they could be "
                           "--no-verify. Write the command literally. " + ADVICE)
            continue
        keys = [key for key, _ in call.config if key.startswith(HOOKS_CONFIG)]
        files = shellparse.config_files(call)
        if keys or files:
            what = f"`{keys[0]}` set on the command line" if keys else f"{files[0]} pointing at another config file"
            reasons.append(f"`git {name}` with {what} can change or skip the repo's hooks. " + ADVICE)
        elif call.sub == "commit":
            problem = commit_problem(call.args)
            if problem == "no-verify":
                reasons.append("`git commit --no-verify` (or -n) skips the pre-commit and commit-msg hooks. " + ADVICE)
            elif problem:
                reasons.append(problem + " Write the options literally. " + ADVICE)
        elif any(not a.dynamic and is_no_verify(a.value) for a in call.args):
            reasons.append(f"`git {call.sub} --no-verify` skips the repo's hooks. " + ADVICE)
    return reasons


if __name__ == "__main__":
    shellparse.main(GUARD, check)
