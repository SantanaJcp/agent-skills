#!/usr/bin/env python3
"""kitchen: install, check and inspect the personal agent setup.

One source of truth for Claude Code and Codex:
  skills/<name>/      -> ~/.claude/skills/<name> and ~/.agents/skills/<name>
  your rules + the PRINCIPLES.md index -> ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md (generated)
  hooks/<guard>       -> PreToolUse hooks in ~/.claude/settings.json and ~/.codex/hooks.json (merged)
Every other installed path is an absolute symlink back into this repo.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(os.environ.get("KITCHEN_REPO") or Path(__file__).resolve().parent.parent).resolve()
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from kitchen import common, credentials, integrate, inventory, journal, status, transcripts  # noqa: E402
from kitchen import agent_hooks, checkplan, environment, models, rules  # noqa: E402
MAX_SKILL_LINES = 150
MAX_DESCRIPTION_CHARS = 1024
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
LINK_RE = re.compile(r"\]\(([^)\s]+)\)")
BLOCK_SCALARS = {">", "|", ">-", "|-", ">+", "|+"}
EXAMPLES = """examples:
  kitchen install             link skills, rules and hooks; then run `kitchen doctor`
  kitchen doctor              prove links, hooks, agent CLIs and schedules on this machine
  kitchen check --fast        what the pre-commit hook runs: lint, safety scan, tests for the staged paths
  kitchen check               everything, as integrate does
  kitchen status --since 7d   where every project stands
  kitchen integrate fix/a fix/b --base origin/dev

run `kitchen <command> --help` for a command's options."""


def home() -> Path:
    return Path(os.environ["HOME"])


def skills_dir() -> Path:
    return REPO / "skills"


def global_rules() -> Path:
    return REPO / "global" / "AGENTS.md"


def skill_target_dirs(h: Path) -> list[Path]:
    return [h / ".claude" / "skills", h / ".agents" / "skills"]


def rules_targets(h: Path) -> list[Path]:
    return [h / ".claude" / "CLAUDE.md", h / ".codex" / "AGENTS.md"]


def repo_skills() -> list[Path]:
    if not skills_dir().is_dir():
        return []
    return sorted(p for p in skills_dir().iterdir() if (p / "SKILL.md").is_file())


def cli_link(h: Path) -> Path:
    return h / ".local" / "bin" / "kitchen"


def planned_links(h: Path) -> list[tuple[Path, Path]]:
    links = [(target / skill.name, skill) for skill in repo_skills() for target in skill_target_dirs(h)]
    links.append((cli_link(h), REPO / "bin" / "kitchen"))
    return links


def link_target(link: Path) -> Path:
    raw = Path(os.readlink(link))
    return Path(os.path.normpath(raw if raw.is_absolute() else link.parent / raw))


def owned(link: Path) -> bool:
    return link.is_symlink() and link_target(link).is_relative_to(REPO)


def owned_links_in_targets(h: Path) -> list[Path]:
    found = [d / entry for d in skill_target_dirs(h) if d.is_dir() for entry in os.listdir(d)]
    found += [cli_link(h)]
    return [p for p in found if owned(p)]


def rules_conflicts(h: Path) -> list[Path]:
    """Rule files that are the person's own: not a link into this repo (the old install) and not generated by it."""
    return [t for t in rules_targets(h) if (t.exists() or t.is_symlink()) and not owned(t) and not rules.generated(t)]


def ask_rules(h: Path) -> str:
    current = rules_targets(h)[0]
    was_global = (owned(current) and link_target(current) == global_rules()) or (
        rules.generated(current) and str(global_rules()) in current.read_text(encoding="utf-8").splitlines()[0])
    recommended = "1" if was_global else "3"
    print("\nWhose rules should every agent read, above the kitchen's principles?\n"
          f"   [1] this kitchen's global/AGENTS.md (its owner's rules){' (recommended)' if recommended == '1' else ''}\n"
          "   [2] a file of yours: type its absolute path\n"
          f"   [3] none: the principles only{' (recommended)' if recommended == '3' else ''}")
    while True:
        reply = input("> ").strip() or recommended
        if reply == "1":
            return "global"
        if reply == "3":
            return "none"
        if reply.startswith("/") or reply.startswith("~"):
            return reply
        if reply == "2":
            print("   type the absolute path of your rules file")
            continue
        print("   answer 1 or 3, or type an absolute path")


def ask_projects() -> list[Path]:
    listed = [p for p in common.projects() if p.is_dir()]
    print("\nSet up repos now with `kitchen init` (each one asks its own questions; nothing is pushed)?\n"
          + (f"   [1] all {len(listed)} in your projects.txt\n" if listed else "")
          + "   [2] one: type its path\n   [3] none (recommended): run `kitchen init <repo>` later, in the repos you choose")
    while True:
        reply = input("> ").strip() or "3"
        if reply == "1" and listed:
            return listed
        if reply == "3":
            return []
        if reply == "2":
            print("   type the repo's path")
            continue
        if reply.startswith(("/", "~", ".")):
            return [Path(reply).expanduser()]
        print("   answer " + ("1, " if listed else "") + "2 or 3, or type a path")


def set_hooks_path() -> None:
    if (REPO / ".git").exists():
        subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath", ".githooks"], check=True)


def cmd_install(args: argparse.Namespace) -> int:
    h = home()
    interactive = sys.stdin.isatty()
    try:
        choice = args.rules or rules.configured()
        if choice is None and interactive:
            choice = ask_rules(h)
        rules_file = rules.resolve(choice, REPO)
    except rules.RulesError as error:
        print(f"FAIL  {error}")
        return 1
    rules_text = rules.render(REPO, rules_file)
    plan = planned_links(h)
    conflicts = [link for link, _ in plan if (link.exists() or link.is_symlink()) and not owned(link)] + rules_conflicts(h)
    hook_changes = agent_hooks.plan(h, REPO)
    hook_conflicts = [change.problem for change in hook_changes if change.problem]
    if (conflicts or hook_conflicts) and not args.backup:
        print("Refusing to install: these paths exist and are not managed by kitchen.")
        for link in conflicts:
            print(f"  {link}")
        for problem in hook_conflicts:
            print(f"  {problem}; the kitchen hooks cannot be merged into it")
        print("Inspect them, then rerun with --backup to move them to ~/.kitchen-backups/"
              + (" (a hook file is replaced by one with only the kitchen hooks)." if hook_conflicts else "."))
        return 1

    backup_root = h / ".kitchen-backups" / datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    if conflicts:
        for link in conflicts:
            dest = backup_root / link.relative_to(h)
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(link), str(dest))
            print(f"backed up  {link} -> {dest}")

    wanted = {link: source for link, source in plan}
    for link in owned_links_in_targets(h):
        if link not in wanted:
            link.unlink()
            print(f"removed    {link} (its source is gone)")

    for link, source in plan:
        if link.is_symlink() and link_target(link) == source:
            continue
        if link.is_symlink():
            link.unlink()
        link.parent.mkdir(parents=True, exist_ok=True)
        link.symlink_to(source, target_is_directory=source.is_dir())
        print(f"linked     {link} -> {source}")

    for target in rules_targets(h):
        if rules_text is None:
            if owned(target) or rules.generated(target):
                target.unlink()
                print(f"removed    {target} (no rules and no principles to install)")
            continue
        if rules.generated(target) and target.read_text(encoding="utf-8") == rules_text:
            continue
        if target.is_symlink() or target.exists():
            target.unlink()
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(rules_text, encoding="utf-8")
        print(f"wrote      {target}")
    if choice is not None and choice != rules.configured():
        rules.save(choice)

    for line in agent_hooks.apply(hook_changes, h, backup_root):
        print(line)

    set_hooks_path()
    whose = ("none (principles only)" if rules_file is None else
             f"{rules_file}" + (" (the default: --rules <file> or --rules none to use yours)" if choice is None else ""))
    print(f"installed  {len(repo_skills())} skills, rules: {whose}, principles: {len(rules.principles(REPO))}, "
          f"agent hooks: {len(agent_hooks.guards(REPO))}")
    if interactive:
        from kitchen import init, propose, repocheck
        for project in ask_projects():
            print(f"\n== kitchen init {project}")
            try:
                init.run(project, None, False, False, False, None, False, interactive=True)
            except (init.InitError, repocheck.NotARepo, propose.ProposeError) as error:  # reported; the next repo still gets its turn
                print(f"FAIL  kitchen init {project}: {error}")
    else:
        print("next:      kitchen init <repo>, in each repo you choose")
    print("next:      kitchen models, to set which model reviews, verifies and works for you (each person sets their own)")
    print("next:      kitchen doctor")
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    h = home()
    failures: list[str] = []
    warnings: list[str] = []

    for link, source in planned_links(h):
        if not link.is_symlink():
            failures.append(f"missing link {link} -> {source}")
        elif link_target(link) != source:
            failures.append(f"{link} points to {link_target(link)}, expected {source}")

    wanted = {link for link, _ in planned_links(h)}
    for link in owned_links_in_targets(h):
        if not link.exists():
            failures.append(f"dangling link {link} -> {link_target(link)}")
        elif link not in wanted:
            failures.append(f"stale link {link}: its source is no longer an installable skill; run `bin/kitchen install`")

    try:
        choice = rules.configured()
        expected = rules.render(REPO, rules.resolve(choice, REPO))
    except rules.RulesError as error:
        failures.append(str(error))
        choice, expected = None, None
    for target in rules_targets(h):
        if expected is None:
            continue
        if not (target.exists() or target.is_symlink()):
            failures.append(f"missing rules file {target}: run `bin/kitchen install`")
        elif not rules.generated(target):
            failures.append(f"{target} was not written by this kitchen's install"
                            + (" (it is the old link to global/AGENTS.md)" if owned(target) else "") + "; run `bin/kitchen install`")
        elif target.read_text(encoding="utf-8") != expected:
            failures.append(f"{target} is stale: its rules or PRINCIPLES.md changed since install; run `bin/kitchen install`")
    for author in models.PROVIDERS:
        try:
            models.get("reviewer", author)
        except models.ModelsError as error:
            warnings.append(f"second-opinion on {author}'s work will stop BLOCKED: {error}")
    if choice in (None, "global") and not global_rules().is_file():
        warnings.append("global/AGENTS.md is not in the repo yet; Claude and Codex have no shared global rules")

    on_path = shutil.which("kitchen", path=os.environ.get("PATH", ""))
    if not on_path or Path(on_path).resolve() != (REPO / "bin" / "kitchen").resolve():
        warnings.append(f"`kitchen` on PATH is {on_path or 'missing'}; add {cli_link(h).parent} to PATH so skills and rules can call it")

    hooks = subprocess.run(["git", "-C", str(REPO), "config", "core.hooksPath"], capture_output=True, text=True)
    if hooks.stdout.strip() != ".githooks":
        failures.append("pre-commit hook inactive: run `bin/kitchen install` (sets core.hooksPath=.githooks)")

    infos: list[str] = []
    for level, line in agent_hooks.doctor(h, REPO) + environment.tools(REPO, common.config_dir()) \
            + environment.schedules(platform.system(), h):
        {"FAIL": failures, "WARN": warnings, "INFO": infos}[level].append(line)

    unmanaged = sorted(
        str(d / entry)
        for d in skill_target_dirs(h) if d.is_dir()
        for entry in os.listdir(d)
        if not entry.startswith(".") and not owned(d / entry)
    )

    for line in failures:
        print(f"FAIL  {line}")
    for line in warnings:
        print(f"WARN  {line}")
    for line in infos:
        print(f"INFO  {line}")
    for path in unmanaged:
        print(f"INFO  not managed by kitchen: {path}")
    print(f"{'FAIL' if failures else 'OK'}    {len(repo_skills())} skills, {len(failures)} failures, {len(warnings)} warnings")
    if failures:
        print("next:  fix each FAIL line above; most are fixed by `bin/kitchen install`")
    return 1 if failures else 0


def parse_frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        raise ValueError("SKILL.md must start with a --- frontmatter block")
    end = text.find("\n---", 4)
    if end == -1:
        raise ValueError("frontmatter block is not closed")
    fields: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if not line.strip() or line.startswith((" ", "\t", "#")):
            continue
        key, sep, value = line.partition(":")
        if not sep:
            raise ValueError(f"frontmatter line is not `key: value`: {line!r}")
        value = value.strip()
        if value in BLOCK_SCALARS:
            raise ValueError(f"`{key.strip()}` uses a YAML block scalar; keep it on one line")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        fields[key.strip()] = value
    return fields


def lint_skill(skill: Path) -> list[str]:
    problems: list[str] = []
    manifest = skill / "SKILL.md"
    if not manifest.is_file():
        return [f"{skill.name}: missing SKILL.md"]
    text = manifest.read_text(encoding="utf-8")
    try:
        fields = parse_frontmatter(text)
    except ValueError as error:
        return [f"{skill.name}: {error}"]

    name = fields.get("name", "")
    if name != skill.name:
        problems.append(f"{skill.name}: frontmatter name {name!r} must equal the directory name")
    if not NAME_RE.match(skill.name):
        problems.append(f"{skill.name}: directory name must be kebab-case")
    description = fields.get("description", "")
    if not description:
        problems.append(f"{skill.name}: description is required")
    elif len(description) > MAX_DESCRIPTION_CHARS:
        problems.append(f"{skill.name}: description has {len(description)} chars (max {MAX_DESCRIPTION_CHARS})")

    lines = text.count("\n") + 1
    if lines > MAX_SKILL_LINES:
        problems.append(f"{skill.name}: SKILL.md has {lines} lines (max {MAX_SKILL_LINES}); move detail into a referenced file or a script")

    for target in LINK_RE.findall(text):
        if target.startswith(("http://", "https://", "mailto:", "#")):
            continue
        if not (skill / target.split("#", 1)[0]).exists():
            problems.append(f"{skill.name}: broken link {target}")

    problems += invocation_parity(skill, fields)
    return problems


def invocation_parity(skill: Path, fields: dict[str, str]) -> list[str]:
    """A manual-only skill must be manual-only in Claude Code and in Codex."""
    manual_in_claude = fields.get("disable-model-invocation", "").lower() == "true"
    policy = skill / "agents" / "openai.yaml"
    policy_text = policy.read_text(encoding="utf-8") if policy.is_file() else ""
    manual_in_codex = re.search(r"^\s*allow_implicit_invocation:\s*false\s*$", policy_text, re.MULTILINE) is not None
    if manual_in_claude and not manual_in_codex:
        return [f"{skill.name}: manual-only for Claude but not for Codex; add agents/openai.yaml with `allow_implicit_invocation: false`"]
    if manual_in_codex and not manual_in_claude:
        return [f"{skill.name}: manual-only for Codex but not for Claude; add `disable-model-invocation: true` to SKILL.md"]
    return []


def git_bytes(*args: str) -> bytes:
    result = subprocess.run(["git", "-C", str(REPO), *args], capture_output=True)
    if result.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)} failed: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout


def publishable_texts() -> list[tuple[str, str]]:
    """(label, text) for every file the next commit or push can publish.

    The working tree and the index can differ: a secret staged and then removed from the working
    file would still be committed. So the exact staged blobs are scanned too, read NUL-safe.
    """
    working: dict[str, bytes] = {}
    for raw in git_bytes("ls-files", "-z", "-co", "--exclude-standard").split(b"\0"):
        name = os.fsdecode(raw)
        if raw and (REPO / name).is_file():
            working[name] = (REPO / name).read_bytes()
    texts = list(working.items())
    for raw in git_bytes("diff", "--cached", "--name-only", "-z", "--diff-filter=ACMR").split(b"\0"):
        name = os.fsdecode(raw)
        blob = git_bytes("cat-file", "blob", f":{name}") if raw else None
        if blob is not None and blob != working.get(name):
            texts.append((f"{name} (staged)", blob))
    decoded = []
    for label, data in texts:
        try:
            decoded.append((label, data.decode("utf-8")))
        except UnicodeDecodeError:
            continue
    return decoded


def public_safety() -> tuple[list[str], list[str]]:
    """The repo is public: no personal absolute paths, no private terms, no credentials."""
    patterns = [("personal path", re.compile(r"/(?:Users|home)/[A-Za-z0-9._-]+/"))]
    patterns += [(label, pattern) for label, pattern in credentials.CREDENTIALS]
    warnings: list[str] = []
    terms = common.private_terms()
    if terms is not None:
        patterns += [("private term", pattern) for pattern in terms]
    else:
        warnings.append(f"private-term scan skipped: {common.denylist_path()} does not exist")

    problems: list[str] = []
    for label_path, text in publishable_texts():
        for number, line in enumerate(text.splitlines(), start=1):
            for label, pattern in patterns:
                if pattern.search(line):
                    problem = f"{label_path}:{number}: {label} in a public repo"
                    if problem not in problems:
                        problems.append(problem)
    return problems, warnings


def cmd_check(args: argparse.Namespace) -> int:
    root = Path(args.skills_dir).resolve() if args.skills_dir else skills_dir()
    skills = sorted(p for p in root.iterdir() if p.is_dir()) if root.is_dir() else []
    problems = [problem for skill in skills for problem in lint_skill(skill)]
    safety_problems, warnings = ([], []) if args.skills_dir else public_safety()
    problems += safety_problems
    for problem in problems:
        print(f"FAIL  {problem}")
    for warning in warnings:
        print(f"WARN  {warning}")
    print(f"{'FAIL' if problems else 'OK'}    lint: {len(skills)} skills, {len(problems)} problems")
    if problems:
        return 1
    if args.lint_only:
        return 0
    modules = checkplan.test_modules(REPO)
    run, skipped = checkplan.select(modules, checkplan.staged_paths(REPO)) if args.fast else (modules, [])
    for module, why in skipped:
        print(f"SKIP  {module}: {why} (`bin/kitchen check` runs it)")
    if checkplan.AUTOMATION_SUITE in run:
        problem = environment.automation_tools_problem(REPO)
        if problem:
            print(f"FAIL  {problem}")
            return 1
    if args.fast and not run:
        print("OK    tests: none needed for the staged paths")
        return 0
    # A git hook exports GIT_DIR, GIT_INDEX_FILE and friends. Tests build throwaway repos; inheriting those
    # variables would point their git commands at this repo (in a worktree: commits, branches, core.bare).
    test_env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    selection = [checkplan.dotted(m) for m in run] if args.fast else ["discover", "-s", "tests", "-t", "."]
    tests = subprocess.run([sys.executable, "-m", "unittest", *selection], cwd=REPO, env=test_env)
    return tests.returncode


def cmd_log(args: argparse.Namespace) -> int:
    entry = journal.write(args.message, args.status, Path.cwd())
    print(f"logged  {entry['status']} · {entry['repo']} @ {entry['sha'] or 'no git'} · {entry['agent']}")
    problem = journal.notify_owner(entry)
    if problem:
        print(f"kitchen log: {problem}", file=sys.stderr)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    since = common.parse_since(args.since)
    by_name = {project.name: project for project in common.projects()}
    repos = [by_name.get(p) or Path(p).resolve() for p in args.paths] or common.projects()
    if not repos:
        print(f"No projects: list one path per line in {common.config_dir() / 'projects.txt'}, or pass paths.")
        return 1
    report = status.build(repos, since)
    if args.exceptions:
        lines = status.exceptions(report)
        if lines:
            print("\n".join(lines))
        return 1 if lines else 0
    print(json.dumps(report, indent=2, ensure_ascii=False) if args.json else status.render(report, args.since))
    return 0


def cmd_inventory(args: argparse.Namespace) -> int:
    report = inventory.build(REPO)
    print(json.dumps(report, indent=2, ensure_ascii=False) if args.json else inventory.render(report))
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    from kitchen import init, propose, repocheck  # local import: keeps this subcommand out of the shared import line
    try:
        return init.run(Path(args.path), args.branch, args.check, args.yes, args.prove, args.base, args.json)
    except repocheck.NotARepo as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return repocheck.NOT_A_REPO
    except (propose.ProposeError, init.InitError) as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return 1
    except propose.Interrupted as error:
        print(f"FAIL  interrupted by {error}: stopped the running check's process group and removed the temporary worktree",
              file=sys.stderr)
        return 128 + error.signum
    except EOFError:
        print("FAIL  input ended before every question was answered; nothing more was written", file=sys.stderr)
        return 2


def cmd_models(args: argparse.Namespace) -> int:
    try:
        if args.action == "set":
            models.put(args.role, args.author, {"provider": args.provider, "model": args.model, "effort": args.effort, "tier": args.tier})
            print(f"set        {args.role}{' for ' + args.author + ' work' if args.author else ''} in {models.path()}")
            return 0
        if args.action == "get":
            entry = models.get(args.role, args.author)
            if args.command:
                print(models.shell(models.command(entry)))
            else:
                print(json.dumps(entry) if args.json else f"{entry['provider']} {entry['model']} · effort {entry['effort']} · tier {entry['tier']}")
            return 0
        print(models.render())
        return 0
    except models.ModelsError as error:
        print(f"FAIL  {error}", file=sys.stderr)
        return 1


def cmd_retro(args: argparse.Namespace) -> int:
    prompts, coverage = transcripts.collect(common.parse_since(args.since), args.tool, args.match, args.include_automated)
    if args.json:
        print(json.dumps(prompts, indent=2, ensure_ascii=False))
        print(transcripts.coverage_line(coverage), file=sys.stderr)  # keeps stdout parseable
    else:
        print(transcripts.render(prompts, args.full, coverage))
    return 0


def cmd_integrate(args: argparse.Namespace) -> int:
    repo = Path(args.repo).resolve()
    project = args.project or repo.name
    try:
        base = integrate.base_for(project, args.base)
    except integrate.IntegrateError as error:
        print(f"FAIL  {project}: {error}")
        return 1
    if args.recorded:
        valid, message = integrate.recorded(repo, base, args.refs, project, args.check)
        print(f"{'PASS' if valid else 'FAIL'}  {project}: {message}")
        return 0 if valid else 1
    record = integrate.integrate(repo, base, args.refs, project, args.check)
    print(integrate.render(record))
    return 0 if record["status"] == "PASS" else 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="kitchen", description=__doc__, epilog=EXAMPLES,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    install = sub.add_parser("install", help="link skills and agent hooks, and write your rules plus the principles index, for Claude Code and Codex")
    install.add_argument("--backup", action="store_true", help="move conflicting unmanaged paths to ~/.kitchen-backups/")
    install.add_argument("--rules", help="whose rules every agent reads above the principles: `global` (this kitchen's global/AGENTS.md), "
                                         "an absolute path, or `none`; remembered in ~/.config/kitchen/rules.txt (asked in a terminal)")
    install.set_defaults(func=cmd_install)

    doctor = sub.add_parser("doctor", help="verify links, agent hooks, agent CLIs, automation tools and schedules")
    doctor.set_defaults(func=cmd_doctor)

    check = sub.add_parser("check", help="lint skills and run the repo tests")
    check.add_argument("--lint-only", action="store_true")
    check.add_argument("--fast", action="store_true", help="run only the test modules the staged paths need (the pre-commit hook)")
    check.add_argument("--skills-dir", help="lint this directory instead of the repo skills")
    check.set_defaults(func=cmd_check)

    log = sub.add_parser("log", help="leave a checkpoint for kitchen status (autonomous runs)")
    log.add_argument("message")
    log.add_argument("--status", choices=journal.STATUSES, default="note")
    log.set_defaults(func=cmd_log)

    stat = sub.add_parser("status", help="where every project stands: git, PRs, nightly guard, gardener, journal, decisions")
    stat.add_argument("paths", nargs="*", help="project paths or configured project names; default: ~/.config/kitchen/projects.txt")
    stat.add_argument("--since", default="24h", help="journal window, e.g. 24h or 7d")
    stat_output = stat.add_mutually_exclusive_group()
    stat_output.add_argument("--json", action="store_true")
    stat_output.add_argument("--exceptions", action="store_true", help="print only the lines that are not green; exit 1 when there are any")
    stat.set_defaults(func=cmd_status)

    inv = sub.add_parser("inventory", help="skills, rule files and automations the agents can see, and their drift")
    inv.add_argument("--json", action="store_true")
    inv.set_defaults(func=cmd_inventory)

    init_cmd = sub.add_parser("init", help="set one repo up for a trustworthy agent loop: check, ask, then propose a branch and add it to your kitchen")
    init_cmd.add_argument("path", help="repository to set up")
    init_cmd.add_argument("--check", action="store_true",
                          help="read-only: run no repository code, print PASS/FAIL/unknown per criterion; exit code = must-haves not PASS")
    init_cmd.add_argument("--yes", action="store_true", help="take the recommended answers without asking (never runs repository code)")
    init_cmd.add_argument("--prove", action="store_true",
                          help="answer yes to proving the gate: RUNS REPOSITORY CODE in a temporary worktree (bin/check commit, a negative control, the hook)")
    init_cmd.add_argument("--base", help="shared base branch for integrate.toml (default: origin/HEAD; asked when unknown)")
    init_cmd.add_argument("--branch", help="shared branch to read for a required status (default: the GitHub default branch)")
    init_cmd.add_argument("--json", action="store_true")
    init_cmd.set_defaults(func=cmd_init)

    mod = sub.add_parser("models", help="which model does each role (reviewer, verifier, worker, explorer), in your own setup")
    mod_sub = mod.add_subparsers(dest="action")
    mod_get = mod_sub.add_parser("get", help="print one role's model; fails, with the command that sets it, when it is not configured")
    mod_set = mod_sub.add_parser("set", help="set one role's model")
    for p_role in (mod_get, mod_set):
        p_role.add_argument("role", choices=models.BY_AUTHOR + models.SINGLE)
        p_role.add_argument("--author", choices=models.PROVIDERS, help="who wrote the work (reviewer and verifier only)")
    mod_get.add_argument("--json", action="store_true")
    mod_get.add_argument("--command", action="store_true", help="print the CLI call for this role (codex exec or claude -p); the prompt goes last")
    mod_set.add_argument("--provider", required=True, choices=models.PROVIDERS)
    mod_set.add_argument("--model", required=True, help="a model id, or `default` for that tool's own default")
    mod_set.add_argument("--effort", required=True, choices=models.EFFORTS)
    mod_set.add_argument("--tier", required=True, choices=models.TIERS)
    mod.set_defaults(func=cmd_models, action=None)

    retro = sub.add_parser("retro", help="my prompts from Claude Code and Codex transcripts")
    retro.add_argument("--since", default="7d")
    retro.add_argument("--tool", choices=("all", "claude", "codex"), default="all")
    retro.add_argument("--match", help="only prompts matching this regex (case-insensitive)")
    retro.add_argument("--full", action="store_true", help="do not truncate prompts")
    retro.add_argument("--include-automated", action="store_true",
                       help="also show messages excluded by provenance (automations, notifications, subagents, agent-launched runs), tagged with the reason")
    retro.add_argument("--json", action="store_true")
    retro.set_defaults(func=cmd_retro)

    integ = sub.add_parser("integrate", help="merge branches in order onto a base in a disposable clone and run the project's checks after each merge")
    integ.add_argument("refs", nargs="+", help="branches, SHAs or pr:<number>, in merge order")
    integ.add_argument("--repo", default=".", help="source repository (default: current directory)")
    integ.add_argument("--base", help="ref to merge onto (default: the project's `base` in integrate.toml; there is no other default)")
    integ.add_argument("--project", help="project name in ~/.config/kitchen/integrate.toml (default: repo folder name)")
    integ.add_argument("--check", action="append", help="check command to run instead of the configured ones (repeatable)")
    integ.add_argument("--recorded", action="store_true", help="run nothing: PASS only if a recorded PASS matches the refs' current SHAs")
    integ.set_defaults(func=cmd_integrate)

    args = parser.parse_args()
    if args.command == "init" and args.check and (args.yes or args.prove or args.base):
        init_cmd.error("--check only reads: it takes no --yes, --prove or --base")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
