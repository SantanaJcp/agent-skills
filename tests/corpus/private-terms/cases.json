{
  "detector": "public safety: private terms from the denylist and personal paths, in `kitchen check`",
  "denylist": ["acmecorp", "Kestrel", "novus"],
  "format": "same as credentials. redact applies to kitchen.transcripts.scrub, which removes denylisted terms; personal paths are not redacted.",
  "cases": [
    {"id": "lowercase-term-any-case", "kind": "positive", "text": "built for AcmeCorp", "check": ["private term"], "redact": "removes", "secret": ["AcmeCorp"]},
    {"id": "capitalized-term-exact", "kind": "positive", "text": "built for Kestrel", "check": ["private term"], "redact": "removes", "secret": ["Kestrel"]},
    {"id": "capitalized-term-common-word", "kind": "negative", "text": "a kestrel flew by", "check": [], "redact": "keeps"},
    {"id": "term-inside-a-word", "kind": "negative", "text": "a novusual word", "check": [], "redact": "keeps"},
    {"id": "staged-only-term", "kind": "bypass", "found": "2026-10-03 review: check read the working tree while the hook commits the index", "where": "staged-only", "text": "deployed at acmecorp", "check": ["private term"]},
    {"id": "personal-path", "kind": "positive", "text": ["see /", "Users/someone/project"], "check": ["personal path"]},
    {"id": "linux-personal-path", "kind": "positive", "text": ["see /", "home/someone/.config"], "check": ["personal path"]},
    {"id": "system-path", "kind": "negative", "text": "see /usr/local/bin and /home alone", "check": []},
    {"id": "term-in-a-sentence-redacted", "kind": "bypass", "found": "2026-10-03 owner verification: retro and issue-log redaction kept private terms", "text": "the ACMECORP deploy failed", "check": ["private term"], "redact": "removes", "secret": ["ACMECORP"]}
  ]
}
